<UserControl x:Class="Frontend.Views.RegisterView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Frontend.Views"
        xmlns:vm="clr-namespace:Frontend.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:RegisterViewModel}"
        Background="{DynamicResource Background}">



    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border BorderBrush="{DynamicResource Border}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="32,28"
                Margin="16"
                MaxWidth="420"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <StackPanel Width="250">
                <Image Source="/Images/enr_logo.png" Height="45" Width="45" Stretch="Uniform" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,0,16"/>
                <TextBlock Text="Regisztráció"
                           FontSize="25"
                           FontFamily="#Inter"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,16"/>

                <TextBlock Text="Felhasználónév"
                           FontSize="13"
                           Margin="0,0,0,4"/>
                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         Height="35"
                         Padding="4,0"
                         VerticalContentAlignment="Center"
                         Margin="0,0,0,12"/>

                <TextBlock Text="Email"
                            FontSize="13"
                            Margin="0,0,0,4"/>
                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                            Height="35"
                            Padding="4,0"
                            VerticalContentAlignment="Center"
                            Margin="0,0,0,12"/>

                <TextBlock Text="Jelszó"
                           FontSize="13"
                           Margin="0,0,0,4"/>
                <PasswordBox Height="35"
                             Padding="4,0"
                             VerticalContentAlignment="Center"
                             PasswordChanged="PasswordBox_PasswordChanged"
                             Margin="0,0,0,12"/>

                <TextBlock Text="{Binding ErrorMessage}"
                           Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"
                           Foreground="{DynamicResource Error}"
                           FontSize="13"
                           TextWrapping="Wrap"
                           Margin="0,0,0,12"/>

                <Button Content="Regisztráció"
                        FontSize="14"
                        Height="35"
                        Command="{Binding RegisterCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        IsDefault="True"
                        Margin="0,0,0,12"/>

                <TextBlock HorizontalAlignment="Center" FontSize="13">
                    <Run Text="Van már fiókod?"/>
                    <Hyperlink Command="{Binding GoToLoginCommand}">Jelentkezz be!</Hyperlink>
                </TextBlock>
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
