<UserControl x:Class="Frontend.Views.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Frontend.Views"
        xmlns:vm="clr-namespace:Frontend.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:LoginViewModel}">
    <UserControl.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#6366F1" Offset="0"/>
            <GradientStop Color="#0EA5E9" Offset="1"/>
        </LinearGradientBrush>
    </UserControl.Background>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24"
              MaxWidth="400"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
        <Border Background="{DynamicResource Surface}"
                    CornerRadius="16">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10"
                                      ShadowDepth="4"
                                      Direction="270"
                                      Color="Black"
                                      Opacity="0.3"/>
            </Border.Effect>
        </Border>
        <Border BorderBrush="{DynamicResource Border}"
                CornerRadius="8"
                Padding="32,28"
                Margin="16"
                MaxWidth="420"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <StackPanel Width="250">
                <Image Source="/Images/enr_logo.png" Height="45" Width="45" Stretch="Uniform" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,0,16"/>
                <TextBlock Text="Üdv újra!"
                           FontSize="25"
                           FontFamily="#Inter"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,4"/>

                <TextBlock Text="Jelentkezz be."
                           FontSize="16"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,24"/>

                <TextBlock Text="Felhasználónév vagy Email"
                           FontSize="13"
                           Margin="0,0,0,4"/>
                <TextBox Height="35"
                         Padding="4,0"
                         VerticalContentAlignment="Center"
                         Text="{Binding UsernameOrEmail, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,12"/>

                <TextBlock Text="Jelszó"
                           FontSize="13"
                           Margin="0,0,0,4"/>
                <PasswordBox Height="35"
                             Padding="4,0"
                             VerticalContentAlignment="Center"
                             Margin="0,0,0,20"
                             PasswordChanged="PasswordBox_PasswordChanged"/>

                <Border Background="#1AE53935" BorderBrush="{DynamicResource Error}"
                        BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,16"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE783;" FontFamily="Segoe MDL2 Assets"
                            Foreground="{DynamicResource Error}" Margin="0,2,8,0"/>
                        <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap"
                            Foreground="{DynamicResource Error}" FontSize="13" MaxWidth="260"/>
                    </StackPanel>
                </Border>


                <Button Content="Bejelentkezés"
                        FontSize="14"
                        Height="35"
                        Command="{Binding LoginCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        IsDefault="True"
                        Margin="0,0,0,12"/>

                <TextBlock HorizontalAlignment="Center" FontSize="13">
                    <Run Text="Nincs még fiókod?"/>
                    <Hyperlink Command="{Binding GoToRegisterCommand}">Regisztrálj!</Hyperlink>
                </TextBlock>
            </StackPanel>
        </Border>
        </Grid>
    </ScrollViewer>
        
</UserControl>