<UserControl x:Class="Frontend.Views.DashboardView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignHeight="400" d:DesignWidth="600" MinWidth="550">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding Username, StringFormat='Szia, {0}!'}" FontSize="24" FontWeight="SemiBold"
                   Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,16"/>

        <TextBlock Grid.Row="1" Text="{Binding ErrorMessage}"
                   Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"
                   Foreground="{DynamicResource Error}"
                   FontSize="13"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12"/>

        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="LEGUTÓBBI ÉRTÉKELÉSEK" Style="{StaticResource CardLabelStyle}"/>
                    <TextBlock Text="{Binding ReviewsThisWeek, StringFormat='Ezen a héten {0}'}" Style="{StaticResource CardValueStyle}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="KEDVENC ÉTTEREMLÁNCOD" Style="{StaticResource CardLabelStyle}"/>
                    <TextBlock Text="{Binding FavoriteFranchise}" Style="{StaticResource CardValueStyle}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="ÉRTÉKELT LÁNCAID" Style="{StaticResource CardLabelStyle}"/>
                    <TextBlock Text="{Binding RatedFranchiseCount}" Style="{StaticResource CardValueStyle}"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- Legutóbbi értékelések -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="Legutóbbi értékelések" Style="{StaticResource CardTitleStyle}"/>
                        <TextBlock Text="A közösség értékelései" Style="{StaticResource CardDetailStyle}"/>
                        <TextBlock Text="Még nincsenek értékelések." Style="{StaticResource CardDetailStyle}" Margin="0,12,0,0"
                           Visibility="{Binding HasNoReviews, Converter={StaticResource BoolToVisibility}}"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding RecentReviews}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource RecentRowButtonStyle}"
                                        Command="{Binding DataContext.OpenReviewCommand,
                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                        <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="10,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                    <TextBlock Text="{Binding RestaurantName}" Style="{StaticResource CardItemTitleStyle}"/>
                                                    <TextBlock Text="{Binding Details}" Style="{StaticResource CardDetailStyle}"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Style="{StaticResource CardItemTitleStyle}" HorizontalAlignment="Right">
                                            <Run Style="{StaticResource StarRunStyle}"/>
                                            <Run Text="{Binding Rating, Mode=OneWay, StringFormat={}{0:0.0}}"/>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding CommentPreview}" Style="{StaticResource CardDetailStyle}" HorizontalAlignment="Right"
                                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Top étteremlánc -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Top étteremlánc" Style="{StaticResource CardTitleStyle}"/>
                        <TextBlock Text="A legjobbra értékelt lánc" Style="{StaticResource CardDetailStyle}"/>

                        <Border Style="{StaticResource CardInsetStyle}"
                        Visibility="{Binding HasTopFranchise, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{Binding TopFranchise.Name}" Style="{StaticResource CardItemTitleStyle}"/>
                                    <TextBlock Grid.Column="1" Style="{StaticResource CardItemTitleStyle}">
                                <Run Style="{StaticResource StarRunStyle}"/>
                                <Run Text="{Binding TopFranchise.AvgOverall, Mode=OneWay, StringFormat={}{0:0.0}}"/>
                                    </TextBlock>
                                </Grid>
                                <TextBlock Text="{Binding TopFranchiseDetails}" Style="{StaticResource CardDetailStyle}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <ItemsControl ItemsSource="{Binding TopRestaurants}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource CardInsetStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource CardItemTitleStyle}"/>
                                                <TextBlock Text="{Binding City}" Style="{StaticResource CardDetailStyle}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Style="{StaticResource CardItemTitleStyle}">
                                        <Run Style="{StaticResource StarRunStyle}"/>
                                        <Run Text="{Binding AvgOverall, Mode=OneWay, StringFormat={}{0:0.0}}"/>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <Grid Grid.RowSpan="4"
      Visibility="{Binding IsReviewOpen, Converter={StaticResource BoolToVisibility}}">

            <Border Background="#50000000">
                <Border.Effect>
                    <BlurEffect Radius="18"/>
                </Border.Effect>
                <Border.InputBindings>
                    <MouseBinding Gesture="LeftClick" Command="{Binding CloseReviewCommand}"/>
                </Border.InputBindings>
            </Border>

            <Border Style="{StaticResource CardStyle}" Padding="24" Width="460"
            HorizontalAlignment="Center" VerticalAlignment="Center"
            DataContext="{Binding SelectedReview}">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButtonStyle}"
                        ToolTip="Bezárás" AutomationProperties.Name="Bezárás"
                        Command="{Binding DataContext.CloseReviewCommand,
                                  RelativeSource={RelativeSource AncestorType=UserControl}}">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets"/>
                        </Button>
                        <StackPanel>
                            <TextBlock Text="{Binding RestaurantName}" Style="{StaticResource CardTitleStyle}"
                               TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Review.FranchiseName, TargetNullValue=Nincs franchise}"
                               Style="{StaticResource CardDetailStyle}"/>
                        </StackPanel>
                    </DockPanel>

                    <TextBlock Style="{StaticResource CardDetailStyle}" Margin="0,8,0,0">
                <Run Text="{Binding Review.Username, Mode=OneWay}"/>
                <Run Text=" · "/>
                <Run Text="{Binding CreatedAtText, Mode=OneWay}"/>
                    </TextBlock>

                    <Border Style="{StaticResource CardInsetStyle}" Padding="16" Margin="0,16,0,0">
                        <TextBlock HorizontalAlignment="Center">
                    <Run Style="{StaticResource StarRunStyle}" FontSize="28"/>
                    <Run Text="{Binding Rating, Mode=OneWay, StringFormat={}{0:0.0}}" FontSize="28" FontWeight="Bold"
                         Foreground="{DynamicResource PrimaryText}"/>
                    <Run Text=" / 5" FontSize="14" Foreground="{DynamicResource MutedText}"/>
                        </TextBlock>
                    </Border>
                    
                    <DockPanel Margin="0,16,0,0">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Review.FoodRating, StringFormat={}{0} / 5}"
                           Style="{StaticResource CardItemTitleStyle}"/>
                        <TextBlock Text="Étel" Style="{StaticResource CardRowLabelStyle}"/>
                    </DockPanel>
                    <DockPanel Margin="0,10,0,0">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Review.ServiceRating, StringFormat={}{0} / 5}"
                           Style="{StaticResource CardItemTitleStyle}"/>
                        <TextBlock Text="Kiszolgálás" Style="{StaticResource CardRowLabelStyle}"/>
                    </DockPanel>
                    <DockPanel Margin="0,10,0,0">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Review.AtmosphereRating, StringFormat={}{0} / 5}"
                           Style="{StaticResource CardItemTitleStyle}"/>
                        <TextBlock Text="Hangulat" Style="{StaticResource CardRowLabelStyle}"/>
                    </DockPanel>

                    <Border Height="1" Background="{DynamicResource Border}" Margin="0,16"/>

                    <TextBlock Text="Megjegyzés" Style="{StaticResource CardItemTitleStyle}"/>
                    <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                        <TextBlock Text="{Binding Comment, TargetNullValue='—'}" TextWrapping="Wrap"
                           Style="{StaticResource CardDetailStyle}"/>
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>