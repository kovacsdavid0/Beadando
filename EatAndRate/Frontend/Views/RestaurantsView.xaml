<UserControl x:Class="Frontend.Views.RestaurantsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:Frontend.Views"
        mc:Ignorable="d"
        d:DesignHeight="450" d:DesignWidth="600">

    <Grid>
        <DockPanel Visibility="{Binding IsFranchiseListVisible, Converter={StaticResource BoolToVisibility}}">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,20">
                <Grid DockPanel.Dock="Right" Width="260" Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBox Height="36" Padding="15,0,3,0" Text="{Binding FranchiseSearchText, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Keresés"/>
                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="12,0,0,0"
                               VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource MutedText}"/>
                    <TextBlock Text="Keresés az éttermek között..." Margin="33,0,0,0" VerticalAlignment="Center"
                               IsHitTestVisible="False" Foreground="{DynamicResource PlaceholderText}"
                               Visibility="{Binding IsFranchiseSearchPlaceholderVisible, Converter={StaticResource BoolToVisibility}}"/>
                </Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Éttermek" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}"/>
                    <TextBlock Text="Fedezd fel az étteremláncokat, és értékeld a kedvenceidet." FontSize="13" Margin="0,4,0,0"
                               Foreground="{DynamicResource MutedText}"/>
                </StackPanel>
            </DockPanel>

            <Border Style="{StaticResource CardStyle}" Padding="20">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding FranchiseSummary}" FontSize="12"
                                   Style="{StaticResource CardDetailStyle}" VerticalAlignment="Center"/>
                        <TextBlock Text="Összes étteremlánc" Style="{StaticResource CardTitleStyle}" VerticalAlignment="Center"/>
                    </DockPanel>

                    <TextBlock DockPanel.Dock="Top" Text="{Binding ErrorMessage}"
                               Foreground="{DynamicResource Error}" TextWrapping="Wrap"/>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Franchises}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource ListItemButtonStyle}"
                                            Command="{Binding DataContext.OpenFranchiseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Width="44" Height="44" CornerRadius="8" Margin="0,0,14,0"
                                                    Background="{DynamicResource Surface}"
                                                    BorderBrush="{DynamicResource Border}" BorderThickness="1">
                                                <Image Width="32" Height="32" Stretch="Uniform"
                                                       RenderOptions.BitmapScalingMode="HighQuality"
                                                       Source="{Binding Name, Converter={StaticResource FranchiseLogo}}"/>
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="14" Style="{StaticResource CardItemTitleStyle}"/>
                                                <TextBlock Text="{Binding ReviewCount, StringFormat={}{0} értékelés}" FontSize="12"
                                                           Style="{StaticResource CardDetailStyle}" Margin="0,3,0,0"/>
                                            </StackPanel>

                                            <Border Grid.Column="2" Background="{DynamicResource SurfaceAlt}" CornerRadius="6"
                                                    Padding="10,4" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding RestaurantCount, StringFormat={}{0} étterem}" FontSize="12"
                                                           Foreground="{DynamicResource SecondaryText}"/>
                                            </Border>

                                            <TextBlock Grid.Column="3" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                       Margin="14,0,4,0" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource MutedText}"/>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </DockPanel>

        <DockPanel Visibility="{Binding IsRestaurantListVisible, Converter={StaticResource BoolToVisibility}}">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                <Button DockPanel.Dock="Left" Command="{Binding BackCommand}" Style="{StaticResource SecondaryButtonStyle}"
                        Margin="0,0,16,0" ToolTip="Vissza" AutomationProperties.Name="Vissza">
                    <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets"/>
                </Button>

                <Grid DockPanel.Dock="Right" Width="220" Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBox Padding="3,0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Keresés"/>
                    <TextBlock Text="Keresés..." Margin="9,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource MutedText}" Visibility="{Binding IsSearchPlaceholderVisible, Converter={StaticResource BoolToVisibility}}"/>
                </Grid>

                <TextBlock Text="{Binding SelectedFranchise.Name}" FontSize="24" FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
            </DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="{Binding ErrorMessage}"
                   Foreground="{DynamicResource Error}" TextWrapping="Wrap"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Restaurants}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                                    BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Image Grid.Column="0" Width="40" Height="40" Margin="0,0,12,0"
                                           Stretch="Uniform" VerticalAlignment="Center"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           Source="{Binding DataContext.SelectedFranchise.Name,
                                                    RelativeSource={RelativeSource AncestorType=UserControl},
                                                    Converter={StaticResource FranchiseLogo}}"/>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PrimaryText}"/>
                                        <TextBlock Foreground="{DynamicResource SecondaryText}">
                                            <Run Text="{Binding City, Mode=OneWay}"/>
                                            <Run Text="{Binding Address, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock FontSize="12" Margin="0,2,0,0" Foreground="{DynamicResource SecondaryText}">
                                            <Run Text="{Binding AvgOverall, Mode=OneWay, StringFormat='★ {0:0.0} / 5', TargetNullValue='★ – / 5'}"/>
                                            <Run Text="·"/>
                                            <Run Text="{Binding ReviewCount, Mode=OneWay}"/>
                                            <Run Text="értékelés"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="Értékeld ★" Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource SecondaryButtonStyle}" 
                                            Command="{Binding DataContext.RateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>

        <Grid Visibility="{Binding IsReviewVisible, Converter={StaticResource BoolToVisibility}}">
            <views:RateView DataContext="{Binding CurrentReview}"/>
        </Grid>
    </Grid>
</UserControl>