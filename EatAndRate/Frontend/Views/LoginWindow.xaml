<Window x:Class="Frontend.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Frontend.Views"
        mc:Ignorable="d"
        Title="Bejelentkezés"
        Height="450" Width="800"
        MinHeight="450" MinWidth="400"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Background}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border BorderBrush="{DynamicResource Border}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="32,28"
                Margin="16"
                MaxWidth="420"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <StackPanel Width="250">
                <TextBlock Text="Üdv újra!"
                           FontSize="25"
                           FontFamily="#Inter"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,4"/>

                <TextBlock Text="Jelentkezz be."
                           FontSize="16"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,24"/>

                <TextBlock Text="Felhasználónév vagy Email"
                           FontSize="13"
                           Margin="0,0,0,4"/>
                <TextBox Height="35"
                         Padding="4,0"
                         VerticalContentAlignment="Center"
                         TextChanged="TextBox_TextChanged"
                         Margin="0,0,0,12"/>

                <TextBlock Text="Jelszó"
                           FontSize="13"
                           Margin="0,0,0,4"/>
                <PasswordBox Height="35"
                             Padding="4,0"
                             VerticalContentAlignment="Center"
                             Margin="0,0,0,20"/>

                <Button Content="Bejelentkezés"
                        FontSize="14"
                        Height="35"
                        Click="Button_Click"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Margin="0,0,0,12"/>

                <TextBlock HorizontalAlignment="Center" FontSize="13">
                    <Run Text="Nincs még fiókod?"/>
                    <Hyperlink>Regisztrálj!</Hyperlink>
                </TextBlock>
            </StackPanel>
        </Border>
    </ScrollViewer>
</Window>