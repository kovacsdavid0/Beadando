<UserControl x:Class="Frontend.Views.RateView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignHeight="550" d:DesignWidth="900">

    <UserControl.Resources>
        <!-- Szöveges "link" gomb -->
        <Style x:Key="LinkButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource MutedText}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- "5 / 5" címke -->
        <Style x:Key="ScoreBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Background}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="12,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Egy értékelési szempont sora -->
        <Style x:Key="RatingRowStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="0,14"/>
        </Style>

        <!-- Csillagok vízszintesen -->
        <ItemsPanelTemplate x:Key="HorizontalPanel">
            <StackPanel Orientation="Horizontal"/>
        </ItemsPanelTemplate>

        <!-- Kattintható csillag -->
        <DataTemplate x:Key="StarButtonTemplate">
            <Button Command="{Binding SelectCommand}" Cursor="Hand" Margin="2,0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Button.Template>
                <TextBlock x:Name="Star" Text="&#xE735;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                           Background="Transparent" Foreground="{DynamicResource Border}"/>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsFilled}" Value="True">
                    <Setter TargetName="Star" Property="Foreground" Value="{DynamicResource Warning}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Csak megjelenített csillag (összesítő) -->
        <DataTemplate x:Key="StarDisplayTemplate">
            <TextBlock x:Name="Star" Text="&#xE735;" FontFamily="Segoe MDL2 Assets" FontSize="20" Margin="2,0"
                       Foreground="{DynamicResource Border}"/>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsFilled}" Value="True">
                    <Setter TargetName="Star" Property="Foreground" Value="{DynamicResource Warning}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <!-- Fejléc -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,20">
            <DockPanel>
                <Button DockPanel.Dock="Left" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButtonStyle}"
                        Margin="0,0,16,0" ToolTip="Vissza" AutomationProperties.Name="Vissza">
                    <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets"/>
                </Button>
                <TextBlock Text="{Binding RestaurantName}" FontSize="24" FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
            </DockPanel>
            <TextBlock Text="Oszd meg a tapasztalatod, és segíts másoknak választani." FontSize="13" Margin="0,8,0,0"
                       Foreground="{DynamicResource MutedText}"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="320"/>
                </Grid.ColumnDefinitions>

                <!-- Értékelő kártya -->
                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="20">
                    <StackPanel>
                        <TextBlock Text="{Binding FormTitle}" Style="{StaticResource CardTitleStyle}"/>
                        <TextBlock Text="Milyen volt a látogatásod? Pontozz 1-től 5-ig." FontSize="12" Margin="0,4,0,6"
                                   Style="{StaticResource CardDetailStyle}"/>

                        <!-- Étel -->
                        <Border Style="{StaticResource RatingRowStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Étel" Style="{StaticResource CardItemTitleStyle}"/>
                                    <TextBlock Text="Ízek, minőség és tálalás" Style="{StaticResource CardDetailStyle}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <ItemsControl Grid.Column="1" ItemsSource="{Binding FoodStars}" VerticalAlignment="Center"
                                              ItemsPanel="{StaticResource HorizontalPanel}" ItemTemplate="{StaticResource StarButtonTemplate}"/>
                                <Border Grid.Column="2" Style="{StaticResource ScoreBadgeStyle}">
                                    <TextBlock Text="{Binding FoodRating, StringFormat={}{0} / 5}" FontSize="12"
                                               Style="{StaticResource CardItemTitleStyle}"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Kiszolgálás -->
                        <Border Style="{StaticResource RatingRowStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Kiszolgálás" Style="{StaticResource CardItemTitleStyle}"/>
                                    <TextBlock Text="Figyelmesség és gyorsaság" Style="{StaticResource CardDetailStyle}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <ItemsControl Grid.Column="1" ItemsSource="{Binding ServiceStars}" VerticalAlignment="Center"
                                              ItemsPanel="{StaticResource HorizontalPanel}" ItemTemplate="{StaticResource StarButtonTemplate}"/>
                                <Border Grid.Column="2" Style="{StaticResource ScoreBadgeStyle}">
                                    <TextBlock Text="{Binding ServiceRating, StringFormat={}{0} / 5}" FontSize="12"
                                               Style="{StaticResource CardItemTitleStyle}"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Hangulat -->
                        <Border Style="{StaticResource RatingRowStyle}" BorderThickness="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Hangulat" Style="{StaticResource CardItemTitleStyle}"/>
                                    <TextBlock Text="Kényelem és környezet" Style="{StaticResource CardDetailStyle}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <ItemsControl Grid.Column="1" ItemsSource="{Binding AtmosphereStars}" VerticalAlignment="Center"
                                              ItemsPanel="{StaticResource HorizontalPanel}" ItemTemplate="{StaticResource StarButtonTemplate}"/>
                                <Border Grid.Column="2" Style="{StaticResource ScoreBadgeStyle}">
                                    <TextBlock Text="{Binding AtmosphereRating, StringFormat={}{0} / 5}" FontSize="12"
                                               Style="{StaticResource CardItemTitleStyle}"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Megjegyzés -->
                        <TextBlock Margin="0,16,0,8">
                            <Run Text="Megjegyzés" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}"/>
                            <Run Text=" (nem kötelező)" FontSize="12" Foreground="{DynamicResource MutedText}"/>
                        </TextBlock>
                        <Grid>
                            <TextBox Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}"
                                     Height="120" Padding="5,4" MaxLength="1000"
                                     TextWrapping="Wrap" AcceptsReturn="True"
                                     VerticalContentAlignment="Top"
                                     VerticalScrollBarVisibility="Auto"
                                     AutomationProperties.Name="Megjegyzés"/>
                            <TextBlock Text="Mi tetszett, és min lehetne javítani?" Margin="13,9,0,0" VerticalAlignment="Top"
                                       IsHitTestVisible="False" Foreground="{DynamicResource PlaceholderText}"
                                       Visibility="{Binding IsCommentPlaceholderVisible, Converter={StaticResource BoolToVisibility}}"/>
                        </Grid>
                        <DockPanel Margin="0,6,0,0">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding CommentLength, StringFormat={}{0} / 1000}"
                                       Style="{StaticResource CardDetailStyle}"/>
                            <TextBlock Text="Az értékelésed nyilvánosan megjelenik." Style="{StaticResource CardDetailStyle}"/>
                        </DockPanel>

                        <TextBlock Text="{Binding ErrorMessage}"
                                   Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"
                                   Foreground="{DynamicResource Error}" TextWrapping="Wrap" Margin="0,12,0,0"/>

                        <Grid Margin="0,20,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Content="Törlés" Padding="20,10"
                                    Style="{StaticResource DangerButtonStyle}" Command="{Binding DeleteCommand}"
                                    Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibility}}"/>
                            <Button Grid.Column="2" Content="Mégse" Padding="20,10" Margin="8,0,8,0"
                                    Style="{StaticResource SecondaryButtonStyle}" Command="{Binding CancelCommand}"/>
                            <Button Grid.Column="3" Content="Értékelés mentése" Padding="20,10"
                                    Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SaveCommand}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Összesítő kártya -->
                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Értékelésed összesítése" Style="{StaticResource CardTitleStyle}"/>

                        <Border Style="{StaticResource CardInsetStyle}" Padding="16,24" Margin="0,16,0,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock HorizontalAlignment="Center">
                                    <Run Text="{Binding Overall, Mode=OneWay, StringFormat={}{0:0.0}}" FontSize="40" FontWeight="Bold"
                                         Foreground="{DynamicResource PrimaryText}"/>
                                    <Run Text=" / 5" FontSize="16" Foreground="{DynamicResource MutedText}"/>
                                </TextBlock>
                                <ItemsControl ItemsSource="{Binding OverallStars}" HorizontalAlignment="Center" Margin="0,4,0,10"
                                              ItemsPanel="{StaticResource HorizontalPanel}" ItemTemplate="{StaticResource StarDisplayTemplate}"/>
                                <TextBlock Text="{Binding OverallLabel}" Style="{StaticResource CardItemTitleStyle}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Összesített pontszám" Style="{StaticResource CardDetailStyle}"
                                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <DockPanel Margin="0,20,0,0">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding FoodRating, StringFormat={}{0} / 5}" Style="{StaticResource CardItemTitleStyle}"/>
                            <TextBlock Text="Étel" FontSize="13" Foreground="{DynamicResource SecondaryText}"/>
                        </DockPanel>
                        <DockPanel Margin="0,12,0,0">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding ServiceRating, StringFormat={}{0} / 5}" Style="{StaticResource CardItemTitleStyle}"/>
                            <TextBlock Text="Kiszolgálás" FontSize="13" Foreground="{DynamicResource SecondaryText}"/>
                        </DockPanel>
                        <DockPanel Margin="0,12,0,0">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding AtmosphereRating, StringFormat={}{0} / 5}" Style="{StaticResource CardItemTitleStyle}"/>
                            <TextBlock Text="Hangulat" FontSize="13" Foreground="{DynamicResource SecondaryText}"/>
                        </DockPanel>

                        <Border Height="1" Background="{DynamicResource Border}" Margin="0,20"/>

                        <TextBlock Text="Minden vélemény számít" Style="{StaticResource CardItemTitleStyle}"/>
                        <TextBlock Text="Írd le a saját élményedet! A részletes, őszinte értékelés másoknak is segít a választásban."
                                   Style="{StaticResource CardDetailStyle}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</UserControl>