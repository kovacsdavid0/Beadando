<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Kártya kerete -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="14,12"/>
    </Style>

    <!-- Alap: ebből származik a többi szöveg -->
    <Style x:Key="BaseCardTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource InterFont}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- Kártya felirata -->
    <Style x:Key="CardLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseCardTextStyle}">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{DynamicResource MutedText}"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

    <!-- Kártya értéke -->
    <Style x:Key="CardValueStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseCardTextStyle}">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
    </Style>

    <!-- Kártya címe -->
    <Style x:Key="CardTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseCardTextStyle}">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
    </Style>

    <!-- Listaelem címe -->
    <Style x:Key="CardItemTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseCardTextStyle}">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
    </Style>

    <!-- Halvány kiegészítő szöveg -->
    <Style x:Key="CardDetailStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseCardTextStyle}">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{DynamicResource MutedText}"/>
    </Style>

    <!-- Kártyán belüli kisebb doboz -->
    <Style x:Key="CardInsetStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Background}"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="Margin" Value="0,8,0,0"/>
    </Style>

</ResourceDictionary>