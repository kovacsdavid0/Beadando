<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Háttér -->
    <SolidColorBrush x:Key="Background"        Color="#070605"/>
    <SolidColorBrush x:Key="Surface"           Color="Black"/>
    <SolidColorBrush x:Key="SurfaceAlt"        Color="#161310"/>

    <!-- Szöveg -->
    <SolidColorBrush x:Key="PrimaryText"       Color="#DEDAD6"/>
    <SolidColorBrush x:Key="SecondaryText"     Color="#B6AFA8"/>
    <SolidColorBrush x:Key="MutedText"         Color="#938A82"/>
    <SolidColorBrush x:Key="PlaceholderText"   Color="#524A42"/>

    <!-- Keretek -->
    <SolidColorBrush x:Key="Border"            Color="#211D19"/>
    <SolidColorBrush x:Key="BorderStrong"      Color="#312B25"/>

    <!-- Sidebar -->
    <SolidColorBrush x:Key="SidebarBackground" Color="#DEDAD6"/>
    <SolidColorBrush x:Key="SidebarHover"      Color="#CBC5BF"/>
    <SolidColorBrush x:Key="SidebarText"       Color="#211D19"/>

    <!-- Primary gomb -->
    <SolidColorBrush x:Key="PrimaryButton"        Color="#4F46E5"/>
    <SolidColorBrush x:Key="PrimaryButtonHover"   Color="#4338CA"/>
    <SolidColorBrush x:Key="PrimaryButtonPressed" Color="#3730A3"/>
    <SolidColorBrush x:Key="PrimaryButtonText"    Color="White"/>

    <!-- Secondary gomb -->
    <SolidColorBrush x:Key="SecondaryButton"        Color="#1E1A16"/>
    <SolidColorBrush x:Key="SecondaryButtonHover"   Color="#29241F"/>
    <SolidColorBrush x:Key="SecondaryButtonPressed" Color="#38312A"/>
    <SolidColorBrush x:Key="SecondaryButtonText"    Color="#DEDAD6"/>

    <!-- Danger gomb (törlés, kilépés) -->
    <SolidColorBrush x:Key="DangerButton"        Color="#DC3545"/>
    <SolidColorBrush x:Key="DangerButtonHover"   Color="#BB2D3B"/>
    <SolidColorBrush x:Key="DangerButtonPressed" Color="#A02834"/>
    <SolidColorBrush x:Key="DangerButtonText"    Color="White"/>

    <!-- Letiltott állapot -->
    <SolidColorBrush x:Key="DisabledBackground" Color="#161310"/>
    <SolidColorBrush x:Key="DisabledText"       Color="#524A42"/>

    <!-- Scrollbar -->
    <SolidColorBrush x:Key="ScrollThumb"       Color="#38312A"/>
    <SolidColorBrush x:Key="ScrollThumbHover"  Color="#524A42"/>

    <!-- Státuszszínek -->
    <SolidColorBrush x:Key="Success" Color="#198754"/>
    <SolidColorBrush x:Key="Warning" Color="#FFC107"/>
    <SolidColorBrush x:Key="Error"   Color="#DC3545"/>

</ResourceDictionary>
