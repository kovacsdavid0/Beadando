<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Háttér -->
    <SolidColorBrush x:Key="Background"        Color="#14120F"/>
    <SolidColorBrush x:Key="Surface"           Color="#1E1B18"/>
    <SolidColorBrush x:Key="SurfaceAlt"        Color="#2A2622"/>

    <!-- Szöveg -->
    <SolidColorBrush x:Key="PrimaryText"       Color="#EAE6E2"/>
    <SolidColorBrush x:Key="SecondaryText"     Color="#C4BDB6"/>
    <SolidColorBrush x:Key="MutedText"         Color="#A39A92"/>
    <SolidColorBrush x:Key="PlaceholderText"   Color="#6E655C"/>

    <!-- Keretek -->
    <SolidColorBrush x:Key="Border"            Color="#36302A"/>
    <SolidColorBrush x:Key="BorderStrong"      Color="#4A423A"/>

    <!-- Sidebar -->
    <SolidColorBrush x:Key="SidebarBackground" Color="#DEDAD6"/>
    <SolidColorBrush x:Key="SidebarHover"      Color="#CBC5BF"/>
    <SolidColorBrush x:Key="SidebarText"       Color="#211D19"/>

    <!-- Primary gomb -->
    <SolidColorBrush x:Key="PrimaryButton"        Color="#4F46E5"/>
    <SolidColorBrush x:Key="PrimaryButtonHover"   Color="#4338CA"/>
    <SolidColorBrush x:Key="PrimaryButtonPressed" Color="#3730A3"/>
    <SolidColorBrush x:Key="PrimaryButtonText"    Color="White"/>

    <!-- Secondary gomb -->
    <SolidColorBrush x:Key="SecondaryButton"        Color="#2A2622"/>
    <SolidColorBrush x:Key="SecondaryButtonHover"   Color="#36302A"/>
    <SolidColorBrush x:Key="SecondaryButtonPressed" Color="#443C35"/>
    <SolidColorBrush x:Key="SecondaryButtonText"    Color="#EAE6E2"/>

    <!-- Danger gomb (törlés, kilépés) -->
    <SolidColorBrush x:Key="DangerButton"        Color="#DC3545"/>
    <SolidColorBrush x:Key="DangerButtonHover"   Color="#BB2D3B"/>
    <SolidColorBrush x:Key="DangerButtonPressed" Color="#A02834"/>
    <SolidColorBrush x:Key="DangerButtonText"    Color="White"/>

    <!-- Letiltott állapot -->
    <SolidColorBrush x:Key="DisabledBackground" Color="#241F1B"/>
    <SolidColorBrush x:Key="DisabledText"       Color="#6E655C"/>

    <!-- Scrollbar -->
    <SolidColorBrush x:Key="ScrollThumb"       Color="#4A423A"/>
    <SolidColorBrush x:Key="ScrollThumbHover"  Color="#62584F"/>

    <!-- Státuszszínek -->
    <SolidColorBrush x:Key="Success" Color="#198754"/>
    <SolidColorBrush x:Key="Warning" Color="#FFC107"/>
    <SolidColorBrush x:Key="Error"   Color="#DC3545"/>

</ResourceDictionary>
